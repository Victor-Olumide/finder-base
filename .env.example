PORT=5000
ADMIN_PASSWORD=change_this_password

# CORS — comma-separated list of allowed frontend origins
# Set to your Vercel URL in production, e.g.:
# ALLOWED_ORIGINS=https://room-finder-abuad.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# Firebase Admin SDK — Option A: paste the full service account JSON as a single line
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Firebase Admin SDK — Option B: individual fields (use one option, not both)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
